# Environment Variables & API Keys Template
# Copy to .env and provide your API keys if available.
# The system runs autonomously with polite web collectors if keys are not provided.

# Web & Review Platform APIs
GOOGLE_PLACES_API_KEY=
TRIPADVISOR_API_KEY=
AGODA_PARTNER_API_KEY=

# LLM Extraction & Summarization APIs
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Crawler & User Agent Configuration
CRAWLER_CONTACT_EMAIL=researcher@clusteriq.org
CRAWLER_DELAY_SECONDS=2.0
